  "_meta": {
    "version": "2.1.0",
    "description": "Theme preset and layout configuration catalog for Citizen and Employee portals",
    "themeTokens": {
      "upyogPurple": {
        "primaryColor": "#584F74",
        "secondaryColor": "#6B54A2",
        "backgroundColor": "#F3F2FA",
        "textColor": "#7F7797",
        "gradient": "linear-gradient(90deg, #6A4A91 0%, #3E285F 100%)"
      },
      "eSathiOrange": {
        "primaryColor": "#CA5100",
        "secondaryColor": "#EA8740",
        "backgroundColor": "#FFF5EF",
        "textColor": "#EA8740",
        "gradient": "linear-gradient(90deg, #EB874A 0%, #873508 100%)"
      },
      "metroBurgundy": {
        "primaryColor": "#7B1123",
        "secondaryColor": "#4D0914",
        "backgroundColor": "#FDF2F4",
        "textColor": "#7B1123",
        "gradient": "linear-gradient(90deg, #7B1123 0%, #4D0914 100%)"
