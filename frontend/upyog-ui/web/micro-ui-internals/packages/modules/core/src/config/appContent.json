  },
  "citizen1": {
    "theme": "upyogPurple",
    "layout": {
      "loginUI": {
        "backgroundUrl": "/upyog-ui/images/onboarding-bg.jpg",
        "mainlogo": {
          "dualLogo": false,
          "url": "/upyog-ui/images/Logo.png"
        },
        "headers": {
          "title": "One Platform",
          "titleHighlight": "Many Services",
          "titleStyles": {
            "color": "#0F172A"
          },
          "titleHighlightStyles": {
            "color": "#584F74"
          },
          "subtitle": "Choose your details to",
          "subtitleHighlight": "get started"
        },
        "pointers": {
          "enabled": true,
          "showIcons": true,
          "hasBackground": true,
          "data": [
            {
              "title": "Easy Access",
              "description": "All your services in one place",
              "iconUrl": "/upyog-ui/images/login-1.svg",
              "iconAlt": "Easy Access"
            },
            {
              "title": "Secure & Trusted",
              "description": "Your data is safe with us",
              "iconUrl": "/upyog-ui/images/login-2.svg",
              "iconAlt": "Secure"
            },
            {
              "title": "Quick & Simple",
              "description": "Login in minutes",
              "iconUrl": "/upyog-ui/images/login-3.svg",
              "iconAlt": "Quick"
            }
          ]
        },
        "footer": {
          "enabled": false
        }
      },
      "loginForm": {},
      "commonConfig": {
        "gradient": "linear-gradient(90deg, #6A4A91 0%, #3E285F 100%)"
      },
      "dashboard": {
        "isV1": true,
        "isV2": false,
        "isOldView": true
      }
    }
  },
