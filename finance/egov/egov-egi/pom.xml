    <build>
        <resources>
            <resource>
                <directory>src/main/java</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/*.*</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${mvn.jar.plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- In egov-egi/pom.xml -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/elasticsearch/**/*.java</exclude>
                        <exclude>**/RestServiceAuthFilter.java</exclude>
                        <exclude>**/SpringMultipartParser.java</exclude>
                        <exclude>**/CacheControlInterceptor.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Exclude Elasticsearch packages from Javadoc - incompatible with Spring Data ES 5.x -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <excludePackageNames>org.egov.infra.elasticsearch.*:org.egov.infra.admin.master.repository.es:org.egov.infra.admin.master.entity.es:org.egov.infra.admin.master.service.es:org.egov.infra.config.elasticsearch</excludePackageNames>
                    <doclint>none</doclint>
                    <failOnError>false</failOnError>
                    <failOnWarnings>false</failOnWarnings>
                </configuration>
            </plugin>

        </plugins>
    </build>




