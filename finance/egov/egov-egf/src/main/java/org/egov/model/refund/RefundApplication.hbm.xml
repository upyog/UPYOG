<?xml version="1.0" encoding="utf-8"?>

<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>

	<class name="org.egov.model.refund.RefundApplication"
		table="EGF_REFUND_APPLICATION">

		<id name="id" type="long" unsaved-value="null">

			<column name="ID" not-null="true" />

			<generator
				class="org.hibernate.id.enhanced.SequenceStyleGenerator">

				<param name="sequence_name">
					SEQ_EGF_REFUND_APPLICATION
				</param>

			</generator>
		</id>

		<property name="tenantId" column="TENANTID" type="string"
			not-null="true" />

		<property name="refundApplicationNumber"
			column="REFUNDAPPLICATIONNUMBER" type="string" not-null="true" />

		<property name="moduleName" column="MODULENAME" type="string"
			not-null="true" />

		<property name="businessService" column="BUSINESSSERVICE"
			type="string" not-null="true" />

		<property name="referenceNumber" column="REFERENCENUMBER"
			type="string" />

		<property name="paymentId" column="PAYMENTID" type="string" />

		<property name="receiptNumber" column="RECEIPTNUMBER"
			type="string" />

		<property name="refundAmount" column="REFUNDAMOUNT"
			type="big_decimal" not-null="true" />

		<property name="refundReason" column="REFUNDREASON"
			type="string" />

		<property name="refundDate" column="REFUNDDATE" type="long" />

		<property name="debitGlCode" column="DEBITGLCODE"
			type="string" />

		<property name="creditGlCode" column="CREDITGLCODE"
			type="string" />

		<property name="status" column="STATUS" type="string"
			not-null="true" />

		<property name="voucherNumber" column="VOUCHERNUMBER"
			type="string" />

		<property name="rejectionReason" column="REJECTIONREASON"
			type="string" />

		<many-to-one name="state"
			class="org.egov.infra.workflow.entity.State" cascade="all">

			<column name="STATE_ID" />

		</many-to-one>

		<property name="createdDate" column="CREATEDDATE"
			type="timestamp" />

		<property name="lastModifiedDate" column="LASTMODIFIEDDATE"
			type="timestamp" />

		<property name="createdBy" type="long">

			<column name="CREATEDBY" precision="22" scale="0" />

		</property>

		<property name="lastModifiedBy" type="long">

			<column name="LASTMODIFIEDBY" precision="22" scale="0" />

		</property>

		<property name="fundCode" column="FUNDCODE" type="string" />

		<property name="departmentCode" column="DEPARTMENTCODE"
			type="string" />

		<property name="functionCode" column="FUNCTIONCODE"
			type="string" />

	</class>

</hibernate-mapping>