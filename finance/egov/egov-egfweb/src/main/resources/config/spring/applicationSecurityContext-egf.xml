<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns:security="http://www.springframework.org/schema/security"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="http://www.springframework.org/schema/beans"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/security
           http://www.springframework.org/schema/security/spring-security.xsd"
       default-lazy-init="true">

    <!--
        Spring Security 6 compatibility:
        Explicit AntPathRequestMatcher beans are used so that these legacy
        URL patterns do not get converted to MvcRequestMatcher.
    -->

    <bean id="commonsMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/commons/**"/>
    </bean>

    <bean id="imagesMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/images/**"/>
    </bean>

    <bean id="resourcesMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/resources/**"/>
    </bean>

    <bean id="indexMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/index.jsp"/>
    </bean>

    <bean id="errorMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/error/**"/>
    </bean>

    <bean id="strutsMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/struts/**"/>
    </bean>

    <bean id="commonyuiBuildMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/commonyui/build/**"/>
    </bean>

    <bean id="commonyuiYuiMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/commonyui/yui2.7/**"/>
    </bean>

    <bean id="scriptMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/script/**"/>
    </bean>

    <bean id="javascriptMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/javascript/**"/>
    </bean>

    <bean id="preApprovedVoucherMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/voucher/preApprovedVoucher-loadvoucherview.action"/>
    </bean>

    <bean id="paymentViewMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/payment/payment-view.action"/>
    </bean>

    <bean id="remitRecoveryMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/deduction/remitRecovery-beforeView.action"/>
    </bean>

    <bean id="contingentBillMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/bill/contingentBill-beforeView.action"/>
    </bean>

    <bean id="ajaxLoadAccountNumbersMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/voucher/common-ajaxLoadAccountNumbers.action"/>
    </bean>

    <bean id="ajaxLoadSLreportCodesMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/voucher/common-ajaxLoadSLreportCodes.action"/>
    </bean>

    <bean id="ajaxLoadSubLedgerTypesMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/voucher/common-ajaxLoadSubLedgerTypesByGlCode.action"/>
    </bean>

    <bean id="expenseBillPrintMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/bill/expenseBillPrint*.action"/>
    </bean>

    <bean id="ajaxLoadEntitiesMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/voucher/common-ajaxLoadEntitesBy20.action"/>
    </bean>

    <bean id="ajaxLoadGLreportCodesMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/voucher/common-ajaxLoadGLreportCodes.action"/>
    </bean>

    <bean id="contraBTBMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/contra/contraBTB-beforeView.action"/>
    </bean>

    <bean id="ajaxLoadAllBanksMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/voucher/common-ajaxLoadAllBanks.action"/>
    </bean>

    <bean id="directBankPaymentMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/payment/directBankPayment-beforeView.action"/>
    </bean>

    <bean id="finDashboardMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/findashboard/*"/>
    </bean>

    <bean id="restMatcher"
          class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
        <constructor-arg value="/rest/**"/>
    </bean>


    <bean id="securityFilterChain"
          name="securityFilterChain"
          class="org.springframework.security.web.FilterChainProxy">

        <constructor-arg>
            <list>

                <security:filter-chain
                        request-matcher-ref="commonsMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="imagesMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="resourcesMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="indexMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="errorMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="strutsMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="commonyuiBuildMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="commonyuiYuiMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="scriptMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="javascriptMatcher"
                        filters="none"/>

                <!--
                Existing report filter chains remain intentionally commented out.

                /report/dayBookReport*.action
                /report/trialBalance*.action
                /report/bankBookReport*.action
                /report/subLedgerScheduleReport*.action
                /report/subLedgerReport*.action
                /report/generalLedgerReport*.action
                /report/openingBalanceReport*.action
                /report/incomeExpenditureReport*.action
                /report/balanceSheetReport*.action
                /report/billPaymentVoucherPrint*.action
                -->

                <security:filter-chain
                        request-matcher-ref="preApprovedVoucherMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="paymentViewMatcher"
                        filters="csrfFilter"/>

                <security:filter-chain
                        request-matcher-ref="remitRecoveryMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="contingentBillMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="ajaxLoadAccountNumbersMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="ajaxLoadSLreportCodesMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="ajaxLoadSubLedgerTypesMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="expenseBillPrintMatcher"
                        filters="none"/>

                <!--
                    These two entries were duplicated in the original file.
                    They are intentionally retained so this migration does not
                    alter existing filter-chain ordering/behaviour.
                -->

                <security:filter-chain
                        request-matcher-ref="ajaxLoadSLreportCodesMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="ajaxLoadSubLedgerTypesMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="ajaxLoadEntitiesMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="ajaxLoadGLreportCodesMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="contraBTBMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="ajaxLoadAllBanksMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="directBankPaymentMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="finDashboardMatcher"
                        filters="none"/>

                <security:filter-chain
                        request-matcher-ref="restMatcher"
                        filters="none"/>

                <!--
                    Keep /** as pattern.
                    Spring Security treats the catch-all pattern specially
                    rather than creating an MvcRequestMatcher for it.
                -->
                <security:filter-chain
                        pattern="/**"
                        filters="concurrentSessionFilter,securityContextPersistenceFilter,logoutFilter,authenticationProcessingFilter,headerWriterFilter,csrfFilter,securityContextHolderAwareRequestFilter,rememberMeAuthenticationFilter,anonymousAuthenticationFilter,exceptionTranslationFilter,filterSecurityInterceptor"/>

            </list>
        </constructor-arg>

    </bean>

</beans>