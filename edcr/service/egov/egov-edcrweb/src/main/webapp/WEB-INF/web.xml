<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">

    <display-name>e-governments edcr web</display-name>

    <!-- The definition of the Root Spring Container shared by all Servlets and Filters -->
    <context-param>
        <param-name>contextConfigLocation</param-name>
        <param-value>classpath*:config/spring/applicationContext-edcrweb.xml</param-value>
    </context-param>
    <context-param>
        <param-name>locatorFactorySelector</param-name>
        <param-value>classpath*:config/spring/applicationContext-erp.xml</param-value>
    </context-param>
    <context-param>
        <param-name>parentContextKey</param-name>
        <param-value>erpApplicationContext</param-value>
    </context-param>

    <!-- Creates the Spring Container shared by all Servlets and Filters -->
    <listener>
        <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
    </listener>

    <!-- Filter definitions -->
    <filter>
        <filter-name>springSessionRepositoryFilter</filter-name>
        <filter-class>org.springframework.web.filter.DelegatingFilterProxy</filter-class>
    </filter>

    <filter>
        <filter-name>applicationTenantResolverFilter</filter-name>
        <filter-class>org.springframework.web.filter.DelegatingFilterProxy</filter-class>
    </filter>

    <filter>
        <filter-name>openEntityManagerInViewFilter</filter-name>
        <filter-class>org.springframework.orm.jpa.support.OpenEntityManagerInViewFilter</filter-class>
    </filter>

    <filter>
        <filter-name>applicationCoreFilter</filter-name>
        <filter-class>org.springframework.web.filter.DelegatingFilterProxy</filter-class>
    </filter>

    <!--
        Spring Security Filter:
        DelegatingFilterProxy delegates to the 'springSecurityFilterChain' FilterChainProxy bean.
        Note: The redundant duplicate 'securityFilterChain' filter declaration was removed to prevent
        executing Spring Security's filter chain twice on every request.
    -->
    <filter>
        <filter-name>springSecurityFilterChain</filter-name>
        <filter-class>org.springframework.web.filter.DelegatingFilterProxy</filter-class>
    </filter>

    <filter>
        <filter-name>mdcLoggingFilter</filter-name>
        <filter-class>org.egov.infra.web.filter.MDCLoggingFilter</filter-class>
    </filter>

    <!-- Filter mappings — REQUEST + ASYNC only, never ERROR to prevent dispatch loops -->
    <filter-mapping>
        <filter-name>springSessionRepositoryFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>ASYNC</dispatcher>
    </filter-mapping>

    <filter-mapping>
        <filter-name>applicationTenantResolverFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>ASYNC</dispatcher>
    </filter-mapping>

    <filter-mapping>
        <filter-name>openEntityManagerInViewFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>ASYNC</dispatcher>
    </filter-mapping>

    <filter-mapping>
        <filter-name>applicationCoreFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>ASYNC</dispatcher>
    </filter-mapping>

    <filter-mapping>
        <filter-name>springSecurityFilterChain</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>ASYNC</dispatcher>
    </filter-mapping>

    <filter-mapping>
        <filter-name>mdcLoggingFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>ASYNC</dispatcher>
    </filter-mapping>

    <!-- DispatcherServlet -->
    <servlet>
        <servlet-name>edcrweb</servlet-name>
        <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
        <init-param>
            <param-name>contextConfigLocation</param-name>
            <param-value>/WEB-INF/spring/edcrweb-servlet.xml</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
        <async-supported>true</async-supported>
        <!--
            Multipart File Upload Configuration (Spring 6 / Servlet 3.1+ Migration):
            Previously, multipart resolution was configured via a CommonsMultipartResolver bean in
            applicationContext-edcrweb.xml (with maxUploadSize="104857600" and maxInMemorySize="1048576").
            In Spring 6, CommonsMultipartResolver was removed because Apache Commons FileUpload was retired
            in favor of the standard Servlet container multipart support (StandardServletMultipartResolver).
            Under Servlet 3.1+, multipart limits must be declared directly on the DispatcherServlet via
            <multipart-config> in web.xml, while StandardServletMultipartResolver is declared in edcrweb-servlet.xml.
        -->
        <multipart-config>
            <max-file-size>104857600</max-file-size> <!-- 100MB per file (formerly CommonsMultipartResolver maxUploadSize) -->
            <max-request-size>104857600</max-request-size> <!-- 100MB total request size -->
            <file-size-threshold>1048576</file-size-threshold> <!-- 1MB in-memory threshold (formerly CommonsMultipartResolver maxInMemorySize) -->
        </multipart-config>
    </servlet>

    <servlet-mapping>
        <servlet-name>edcrweb</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

    <!-- Error pages -->
    <error-page>
        <exception-type>org.egov.infra.validation.exception.ApplicationRestException</exception-type>
        <location>/rest/dcr/error</location>
    </error-page>

    <error-page>
        <exception-type>org.egov.infra.exception.ApplicationRuntimeException</exception-type>
        <location>/error/500</location>
    </error-page>
<!-- Verified the configuration. The /error/404 endpoint/page is not available in the
     application, so the 404 error-page mapping is not required and has been kept disabled.-->

<!--     <error-page>-->
<!--        <error-code>404</error-code>-->
<!--        <location>/error/404</location>-->
<!--    </error-page>-->

</web-app>