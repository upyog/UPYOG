<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://maven.apache.org/POM/4.0.0"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.egov.edcr</groupId>
		<artifactId>egov-erp</artifactId>
		<version>2.1.1-SNAPSHOT</version>
	</parent>

	<name>e-governments edcr extract</name>

	<artifactId>egov-edcr-extract</artifactId>

	<organization>
		<name>eGovernments Foundation</name>
		<url>http://www.egovernments.org</url>
	</organization>
	<distributionManagement>
		<repository>
			<id>repo.egovernments.org</id>
			<name>eGov ERP Releases Repository</name>
			<url>
				http://repo.egovernments.org/nexus/content/repositories/releases/</url>
		</repository>
		<snapshotRepository>
			<id>repo.egovernments.org</id>
			<name>eGov ERP Snapshots Repository</name>
			<url>
				http://repo.egovernments.org/nexus/content/repositories/snapshots/</url>
		</snapshotRepository>
	</distributionManagement>
	<repositories>
		<!-- Highest priority: Local project lib directory -->
		<repository>
			<id>in-project</id>
			<name>In Project Repo</name>
			<url>file://${project.basedir}/lib/</url>
			<releases>
				<enabled>true</enabled>
				<updatePolicy>always</updatePolicy>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>

		<!-- Digit Nexus -->
		<repository>
			<id>repo.egovernments.org</id>
			<name>eGov Public Repository Group</name>
			<url>https://nexus-repo.digit.org/nexus/content/groups/public/</url>
			<snapshots>
				<enabled>true</enabled>
				<updatePolicy>always</updatePolicy>
			</snapshots>
			<releases>
				<enabled>true</enabled>
			</releases>
		</repository>

		<!-- JBoss -->
		<repository>
			<id>JBoss Repository</id>
			<url>https://repository.jboss.org/nexus/content/groups/public/</url>
		</repository>

		<!-- Jaspersoft -->
		<repository>
			<id>jspresso-mirror</id>
			<url>
				https://jaspersoft.jfrog.io/jaspersoft/third-party-ce-artifacts/</url>
		</repository>
	</repositories>

	<pluginRepositories>
		<pluginRepository>
			<id>repo.egovernments.org</id>
			<name>eGov Public Repository Group</name>
			<url>https://nexus-repo.digit.org/nexus/content/groups/public/</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>
	<dependencies>
		<dependency>
			<groupId>org.kabeja</groupId>
			<artifactId>kabeja</artifactId>
			<version>0.4</version>
		</dependency>

		<dependency>
			<groupId>commons-digester</groupId>
			<artifactId>commons-digester</artifactId>
			<version>2.1</version>
		</dependency>

		<!--<dependency>
			<groupId>org.edcr</groupId>
			<artifactId>batik-all</artifactId>
			<version>1.0</version>
		</dependency>-->
		
		<!-- Batik -->
