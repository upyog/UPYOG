package rules;

import java.util.Map;
import org.upyog.reconciliation.validation.ValidationResult;

global ValidationResult validationResult;
global String tenantId;
global String module;

rule "Check Penalty Amount Non-Negative"
    when
        $data : Map( this["penaltyAmount"] != null, this["penaltyAmount"] < 0 )
    then
        validationResult.addError("penaltyAmount", "Penalty amount cannot be negative.");
end

rule "Check Tax Amount Not Null"
    when
        $data : Map( this["taxAmount"] == null )
    then
        validationResult.addError("taxAmount", "Tax amount cannot be null.");
end
