{
  "moduleName": "gc_citizen_module",
  "description": "Garbage Collection registration workflow",
  "baseUrl": "${selected.url}",
  "instructions": [

    {
      "stepName": "Navigate to Garbage Collection module",
      "locatorStrategy": "XPATH",
      "locatorValue": "//a[@href='${module.gc.url}']",
      "action": "CLICK_JS",
      "inputValue": null,
      "dynamicSleep": 1000
    },
    {
      "stepName": "Click New Request",
      "locatorStrategy": "XPATH",
      "locatorValue": "//*[contains(text(),'New Registration')]",
      "action": "CLICK_JS",
      "inputValue": null,
      "dynamicSleep": 1500
    },
    {
      "stepName": "Enter applicant name",
      "locatorStrategy": "NAME",
      "locatorValue": "applicantName",
      "action": "TYPE",
      "inputValue": "${applicant.name}",
      "dynamicSleep": 300
    },
    {
      "stepName": "Applicant Mobile",
      "locatorStrategy": "NAME",
      "locatorValue": "mobileNumber",
      "action": "TYPE",
      "inputValue": "${mobile.number}",
      "dynamicSleep": 500
    },
    {
      "stepName": "Enter email ID",
      "locatorStrategy": "NAME",
      "locatorValue": "emailId",
      "action": "TYPE",
      "inputValue": "${applicant.email}",
      "dynamicSleep": 300
    },
    {
      "stepName":"Save And Next",
      "locatorStrategy":"XPATH",
      "locatorValue":"//button[contains(.,'Save & Next')]",
      "action":"CLICK_JS",
      "dynamicSleep": 2000
    },
    {
      "stepName":"House Number",
      "locatorStrategy":"NAME",
      "locatorValue":"houseNo",
      "action":"TYPE",
      "inputValue":"${house.number}",
      "dynamicSleep": 2000
    },
    {
      "stepName": "House Name",
      "locatorStrategy": "NAME",
      "locatorValue": "houseName",
      "action": "TYPE",
      "inputValue": "${house.name}",
      "dynamicSleep": 500
    },
    {
      "stepName":"Street Name",
      "locatorStrategy":"NAME",
      "locatorValue":"streetName",
      "action":"TYPE",
      "inputValue":"${street.name}",
      "dynamicSleep": 2000
    },
    {
      "stepName":"Address Line 1",
      "locatorStrategy":"NAME",
      "locatorValue":"addressline1",
      "action":"TYPE",
      "inputValue":"${address.line1}",
      "dynamicSleep": 2000
    },
    {
      "stepName": "Landmark",
      "locatorStrategy": "NAME",
      "locatorValue": "landmark",
      "action": "TYPE",
      "inputValue": "${address.landmark}",
      "dynamicSleep": 500
    },
    {
      "stepName": "Select City Dropdown",
      "locatorStrategy": "CSS",
      "locatorValue": "div.select svg.cp",
      "action": "SELECT_DROPDOWN_BY_INDEX",
      "inputValue": "0:0",
      "dynamicSleep": 1000
    },
    {
      "stepName":"Locality",
      "locatorStrategy":"CSS",
      "locatorValue":"div.select svg.cp",
      "action":"SELECT_DROPDOWN_BY_INDEX",
      "inputValue":"1:0",
      "dynamicSleep": 2000
    },
    {
      "stepName": "Enter Pincode",
      "locatorStrategy": "NAME",
      "locatorValue": "pincode",
      "action": "TYPE",
      "inputValue": "${address.pincode}",
      "dynamicSleep": 500
    },
    {
      "stepName":"Save And Next",
      "locatorStrategy":"XPATH",
      "locatorValue":"//button[contains(.,'Save & Next')]",
      "action":"CLICK_JS",
      "dynamicSleep": 2000
    },
    {
      "stepName": "Select Type of Collection",
      "locatorStrategy": "CSS",
      "locatorValue": "div.select svg.cp",
      "action": "SELECT_DROPDOWN_BY_INDEX",
      "inputValue": "0:1",
      "dynamicSleep": 1000
    },
    {
      "stepName": "Select Owner / Tenant",
      "locatorStrategy": "CSS",
      "locatorValue": "div.select svg.cp",
      "action": "SELECT_DROPDOWN_BY_INDEX",
      "inputValue": "1:0",
      "dynamicSleep": 1000
    },
    {
      "stepName": "Enter Number Of Units",
      "locatorStrategy": "LABEL",
      "locatorValue":"Number of Units",
      "action": "TYPE_BY_LABEL",
      "inputValue": "${product.quantity}",
      "dynamicSleep": 500
    },
    {
      "stepName": "Enter Name",
      "locatorStrategy": "LABEL",
      "locatorValue":"Name",
      "action": "TYPE_BY_LABEL",
      "inputValue": "${applicant.name}",
      "dynamicSleep": 500
    },
    {
      "stepName": "Applicant Mobile",
      "locatorStrategy": "LABEL",
      "locatorValue": "Phone Number",
      "action": "TYPE_BY_LABEL",
      "inputValue": "${mobile.number}",
      "dynamicSleep": 500
    },
    {
      "stepName": "Select Gender",
      "locatorStrategy": "CSS",
      "locatorValue": "div.select svg.cp",
      "action": "SELECT_DROPDOWN_BY_INDEX",
      "inputValue": "2:0",
      "dynamicSleep": 1000
    },
    {
      "stepName": "Select Category",
      "locatorStrategy": "CSS",
      "locatorValue": "div.select svg.cp",
      "action": "SELECT_DROPDOWN_BY_INDEX",
      "inputValue": "3:0",
      "dynamicSleep": 1000
    },
    {
      "stepName": "Select Sub Category",
      "locatorStrategy": "CSS",
      "locatorValue": "div.select svg.cp",
      "action": "SELECT_DROPDOWN_BY_INDEX",
      "inputValue": "4:0",
      "dynamicSleep": 1000
    },
    {
      "stepName": "Select Sub Category Type",
      "locatorStrategy": "CSS",
      "locatorValue": "div.select svg.cp",
      "action": "SELECT_DROPDOWN_BY_INDEX",
      "inputValue": "5:0",
      "dynamicSleep": 1000
    },
    {
      "stepName":"Save And Next",
      "locatorStrategy":"XPATH",
      "locatorValue":"//button[contains(.,'Save & Next')]",
      "action":"CLICK_JS",
      "dynamicSleep": 2000
    },
    {
      "stepName": "Select Special Category",
      "locatorStrategy": "XPATH",
      "locatorValue":"//label[normalize-space()='General']/preceding-sibling::span/input[@type='radio']",
      "action": "CLICK_JS",
      "dynamicSleep": 1000
    },
    {
      "stepName":"Save And Next",
      "locatorStrategy":"XPATH",
      "locatorValue":"//button[contains(.,'Save & Next')]",
      "action":"CLICK_JS",
      "dynamicSleep": 2000
    },
    {
      "stepName": "Upload Applicant Photo",
      "locatorStrategy": "XPATH",
      "locatorValue":"(//input[@type='file'])[1]",
      "action": "UPLOAD_FILE",
      "inputValue": "${document.common.png}",
      "dynamicSleep": 1000
    },
    {
      "stepName": "Upload Identity Proof",
      "locatorStrategy": "XPATH",
      "locatorValue":"(//input[@type='file'])[2]",
      "action": "UPLOAD_FILE",
      "inputValue": "${document.common.proof}",
      "dynamicSleep": 1000
    },
    {
      "stepName": "Upload Address Proof",
      "locatorStrategy": "XPATH",
      "locatorValue":"(//input[@type='file'])[3]",
      "action": "UPLOAD_FILE",
      "inputValue": "${document.common.proof}",
      "dynamicSleep": 1000
    },
    {
      "stepName":"Save And Next",
      "locatorStrategy":"XPATH",
      "locatorValue":"//button[contains(.,'Save & Next')]",
      "action":"CLICK_JS",
      "dynamicSleep": 2000
    },
    {
      "stepName": "Check declaration checkbox",
      "locatorStrategy": "CSS",
      "locatorValue": "input[type='checkbox']",
      "action": "CHECK_LAST_CHECKBOX",
      "inputValue": null,
      "dynamicSleep": 500
    },
    {
      "stepName": "Submit application",
      "locatorStrategy": "XPATH",
      "locatorValue": "//button[@class='submit-bar ' and @type='button'][.//header[text()='Submit']]",
      "action": "CLICK",
      "inputValue": null,
      "dynamicSleep": 2000
    },
    {
      "stepName":"Capture Application Number",
      "locatorStrategy":"XPATH",
      "locatorValue":"//*[contains(text(),'Application No.') or contains(text(),'Application Number')]/following-sibling::*[1]",
      "action":"CAPTURE_TEXT",
      "inputValue":"APPLICATION_NO",
      "dynamicSleep":3000
    }
  ]
}