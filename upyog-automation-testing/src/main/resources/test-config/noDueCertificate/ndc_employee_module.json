{
  "moduleName": "employee_module",
  "description": "No Due Certificate employee approval workflow",
  "baseUrl": "${selected.url}",
  "instructions": [
    {
      "stepName": "Enter username",
      "locatorStrategy": "NAME",
      "locatorValue": "username",
      "action": "TYPE",
      "inputValue": "${selected.username}",
      "dynamicSleep": 300
    },
    {
      "stepName": "Enter password",
      "locatorStrategy": "NAME",
      "locatorValue": "password",
      "action": "TYPE",
      "inputValue": "${selected.password}",
      "dynamicSleep": 300
    },
    {
      "stepName": "Select city from dropdown",
      "locatorStrategy": "CSS",
      "locatorValue": "input.employee-select-wrap--elipses",
      "action": "SELECT_DROPDOWN_BY_INDEX",
      "inputValue": "0:0",
      "dynamicSleep": 500
    },
    {
      "stepName": "Click Continue button",
      "locatorStrategy": "XPATH",
      "locatorValue": "//button[contains(@class, 'submit-bar') and .//header[text()='Continue']]",
      "action": "CLICK",
      "inputValue": null,
      "dynamicSleep": 2000
    },
    {
      "stepName": "Navigate to Garbage Collection inbox",
      "locatorStrategy": "XPATH",
      "locatorValue":"//a[@href='/upyog-ui/employee/ndc/inbox']",
      "action":"CLICK_JS",
      "dynamicSleep": 2000
    },
    {
      "stepName": "Enter Application Number",
      "locatorStrategy": "XPATH",
      "locatorValue": "(//input[@type='text'])[1]",
      "action": "TYPE_FROM_STORE",
      "inputValue": "APPLICATION_NO",
      "dynamicSleep": 1000
    },
    {
      "stepName": "Click Search",
      "locatorStrategy": "XPATH",
      "locatorValue": "//button[normalize-space()='Search']",
      "action": "CLICK_JS",
      "inputValue": null,
      "dynamicSleep": 3000
    },
    {
      "stepName": "Open Application",
      "locatorStrategy": "XPATH",
      "locatorValue": "//table//a[1]",
      "action": "CLICK_JS",
      "inputValue": null,
      "dynamicSleep": 3000
    },
    {
      "stepName":"Take Action Forward",
      "locatorStrategy":"XPATH",
      "locatorValue":"//button[contains(.,'TAKE ACTION')]",
      "action":"CLICK_JS",
      "dynamicSleep": 1000
    },
    {
      "stepName":"Click Forward",
      "locatorStrategy":"XPATH",
      "locatorValue":"//div[contains(@class,'menu-wrap')]//p[normalize-space()='Forward']",
      "action":"CLICK_JS",
      "dynamicSleep": 1000
    },
    {
      "stepName":"Select Employee from Dropdown",
      "locatorStrategy":"CSS",
      "locatorValue": "div.select svg.cp",
      "action":"SELECT_DROPDOWN_BY_INDEX",
      "inputValue":"0:0",
      "dynamicSleep": 1000
    },
    {
      "stepName":"Forward Comment",
      "locatorStrategy":"NAME",
      "locatorValue":"comments",
      "action":"TYPE",
      "inputValue":"${comment.verify}",
      "dynamicSleep": 1000
    },
    {
      "stepName":"Click Forward Popup",
      "locatorStrategy":"XPATH",
      "locatorValue":"//button[contains(@class,'selector-button-primary') and .//h2[normalize-space()='FORWARD']]",
      "action":"CLICK_JS",
      "dynamicSleep": 1000
    },
    {
      "stepName": "Enter Application Number",
      "locatorStrategy": "XPATH",
      "locatorValue": "(//input[@type='text'])[1]",
      "action": "TYPE_FROM_STORE",
      "inputValue": "APPLICATION_NO",
      "dynamicSleep": 1000
    },
    {
      "stepName": "Click Search",
      "locatorStrategy": "XPATH",
      "locatorValue": "//button[normalize-space()='Search']",
      "action": "CLICK_JS",
      "inputValue": null,
      "dynamicSleep": 3000
    },
    {
      "stepName": "Open Application",
      "locatorStrategy": "XPATH",
      "locatorValue": "//table//a[1]",
      "action": "CLICK_JS",
      "inputValue": null,
      "dynamicSleep": 3000
    },
    {
      "stepName":"Take Action Approve",
      "locatorStrategy":"XPATH",
      "locatorValue":"//button[contains(.,'TAKE ACTION')]",
      "action":"CLICK_JS",
      "dynamicSleep": 1000
    },

    {
      "stepName":"Click APPROVE",
      "locatorStrategy":"XPATH",
      "locatorValue":"//div[contains(@class,'menu-wrap')]//p[normalize-space()='Forward Approver']",
      "action":"CLICK_JS",
      "dynamicSleep": 1000
    },

    {
      "stepName":"Approve Comment",
      "locatorStrategy":"NAME",
      "locatorValue":"comments",
      "action":"TYPE",
      "inputValue":"${comment.approve}",
      "dynamicSleep": 1000
    },
    {
      "stepName":"Select Employee from Dropdown",
      "locatorStrategy":"CSS",
      "locatorValue": "div.select svg.cp",
      "action":"SELECT_DROPDOWN_BY_INDEX",
      "inputValue":"0:0",
      "dynamicSleep": 1000
    },
    {
      "stepName":"Click Approve Popup",
      "locatorStrategy":"XPATH",
      "locatorValue":"//button[contains(@class,'selector-button-primary') and .//h2[normalize-space()='Forward Approver']]",
      "action":"CLICK_JS",
      "dynamicSleep": 1000
    },
    {
      "stepName": "Enter Application Number",
      "locatorStrategy": "XPATH",
      "locatorValue": "(//input[@type='text'])[1]",
      "action": "TYPE_FROM_STORE",
      "inputValue": "APPLICATION_NO",
      "dynamicSleep": 1000
    },
    {
      "stepName": "Click Search",
      "locatorStrategy": "XPATH",
      "locatorValue": "//button[normalize-space()='Search']",
      "action": "CLICK_JS",
      "inputValue": null,
      "dynamicSleep": 3000
    },
    {
      "stepName": "Open Application",
      "locatorStrategy": "XPATH",
      "locatorValue": "//table//a[1]",
      "action": "CLICK_JS",
      "inputValue": null,
      "dynamicSleep": 3000
    },
    {
      "stepName":"Take Action Forward",
      "locatorStrategy":"XPATH",
      "locatorValue":"//button[contains(.,'TAKE ACTION')]",
      "action":"CLICK_JS",
      "dynamicSleep": 1000
    },
    {
      "stepName":"Click Forward",
      "locatorStrategy":"XPATH",
      "locatorValue":"//div[contains(@class,'menu-wrap')]//p[normalize-space()='Approve']",
      "action":"CLICK_JS",
      "dynamicSleep": 1000
    },
    {
      "stepName":"Forward Comment",
      "locatorStrategy":"NAME",
      "locatorValue":"comments",
      "action":"TYPE",
      "inputValue":"${comment.verify}",
      "dynamicSleep": 1000
    },
    {
      "stepName":"Click Forward Popup",
      "locatorStrategy":"XPATH",
      "locatorValue":"//button[contains(@class,'selector-button-primary') and .//h2[normalize-space()='APPROVE']]",
      "action":"CLICK_JS",
      "dynamicSleep": 1000
    }
  ]
}